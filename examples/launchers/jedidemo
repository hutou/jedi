#!/usr/bin/env bash

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  printf '%s\n' 'Run this launcher as a command; do not source it.' >&2
  return 1
fi

# JEDI_DEMO_DIR can select another demonstration directory.
demo_dir="${JEDI_DEMO_DIR:-$HOME/jedi-examples}"
CDPATH= cd -- "$demo_dir" || exit 1

unset JEDI_CONFIG_DIR JEDI_LOG_DIR JEDI_DATA_DIR JEDI_DB_FILE JEDI_MARKET_DIR
export JEDI_ENV=test
if [[ -n "${JEDI_DEMO_MARKET_DIR:-}" ]]; then
  export JEDI_MARKET_DIR="$JEDI_DEMO_MARKET_DIR"
fi

binary="$HOME/.local/libexec/jedi"
if [[ ! -f "$binary" || ! -x "$binary" ]]; then
  printf 'Jedi binary missing or not executable: %s\n' "$binary" >&2
  exit 127
fi

exec "$binary" "$@"
